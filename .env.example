# SOC Alliance website: environment variables
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (or let the Storage integrations add them).

# --- Required in production ------------------------------------------------

# Neon Postgres connection string. Vercel → Storage → Neon adds this for you.
# Leave unset locally to use the built-in development database in .data/.
DATABASE_URL=

# Random secret used to sign admin sessions. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The first Owner account, created automatically the first time the database
# has no admin users. Generate the hash with:  npm run admin:hash
# In a local .env file, write every $ in the hash as \$ (Next.js expands $VARS
# in .env files). In Vercel's dashboard, paste the hash exactly as printed.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=

# Vercel Blob read/write token for image uploads. Vercel → Storage → Blob adds this.
# Leave unset locally to save uploads to public/uploads/.
BLOB_READ_WRITE_TOKEN=

# --- Optional: email ---------------------------------------------------------
# Without these, form submissions still arrive in the admin Inbox; they just
# aren't also emailed, and "Forgot password?" links can't be sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "SOC Alliance <noreply@socalliance.org>"
EMAIL_FROM=
